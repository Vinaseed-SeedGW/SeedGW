{
  "name": "seedgw",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up -d && turbo run dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "check:native": "node scripts/check-native-imports.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "map:thu": "node --env-file-if-exists=.env scripts/try-map-key.mjs",
    "check": "pnpm format:check && pnpm check:glyphs && pnpm check:native && pnpm check:scope && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @seedgw/db migrate",
    "db:deploy": "pnpm --filter @seedgw/db deploy:migrations",
    "db:seed": "pnpm --filter @seedgw/db seed"
  },
  "devDependencies": {
    "@seedgw/config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
