<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site "Seedgw" trên IIS máy Windows Server 10.10.8.35 (C:\inetpub\wwwroot\SeedGW\web.config).
  IIS giữ HTTPS cho seedgw.vinaseed.com.vn và chuyển tiếp mọi yêu cầu vào máy ảo Ubuntu chạy SeedGW.
  Trước khi dùng: chạy cau-hinh-iis.ps1 một lần (bật proxy của ARR, giữ Host, không gom phản hồi), rồi thay
  DIA_CHI_MAY_AO bằng IP nội bộ của máy ảo Ubuntu.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Bật khi site đã có chứng chỉ HTTPS: đổi enabled thành true. -->
        <rule name="SeedGW chuyen sang HTTPS" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{UNENCODED_URL}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- Chuyển tiếp nguyên đường dẫn đã mã hoá (link ảnh có chữ ký phải giữ đúng từng ký tự). -->
        <rule name="SeedGW chuyen tiep" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://DIA_CHI_MAY_AO{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <!-- Trang Hỗ trợ cập nhật tức thì bằng SSE: không nén động để phản hồi đi ngay. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <security>
      <requestFiltering>
        <!-- Tệp đính kèm Hỗ trợ tối đa 10 MB, ảnh check-in nhỏ hơn; để 15 MB cho phần đầu yêu cầu. -->
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
