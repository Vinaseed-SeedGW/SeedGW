# Chep file nay thanh .env roi chay du an. Khong commit file .env.

DATABASE_URL="postgresql://seedgw:seedgw_dev_password@localhost:5432/seedgw"
REDIS_URL="redis://localhost:6379"

# Tao chuoi ngau nhien dai it nhat 32 ky tu
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"

# Mat khau cua cac tai khoan mau, chi dung o moi truong phat trien
SEED_PASSWORD="doi-mat-khau-mau"

MINIO_ROOT_USER="seedgw"
MINIO_ROOT_PASSWORD="seedgw_dev_password"

# Khoa API dia chi, chi nam tren may chu, khong dua vao app.
# Thu khoa: pnpm map:thu
VIETMAP_API_KEY=""
GOONG_API_KEY=""

# Ban do nen trang Ban do hanh trinh (V2b). De trong thi dung OpenStreetMap.
# Khi co goi ban do Vietmap: MAP_TILE_URL="https://maps.vietmap.vn/api/tm/{z}/{x}/{y}@2x.png?apikey={apikey}"
# Khoa nay nam trong trinh duyet nguoi xem, dung khoa rieng gioi han theo ten mien.
MAP_TILE_URL=""
MAP_TILE_API_KEY=""
MAP_TILE_ATTRIBUTION=""
# R4: may chu tim duong OSRM noi bo (vd http://osrm:5000 trong Docker). De trong thi bao cao chi co km theo GPS.
OSRM_URL=""

# A8: khoa ma hoa cau hinh ket noi (dia chi, tai khoan FAST) luu trong database. Toi thieu 32 ky tu ngau nhien.
INTEGRATION_SECRET_KEY="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# M7: khoa truy cap Expo cho dich vu day thong bao. Tuy chon; bat Push security tren tai khoan Expo thi bat buoc.
EXPO_ACCESS_TOKEN=""

# Rieng ban thu R3 cua app: khoa Vietmap gan vao app de in dia chi len anh (duyet 13/11/2026).
# Khi build tren Expo, gia tri lay tu bien EAS moi truong "preview", khong lay tu file nay.
# Ban chinh thuc bo bien nay, app hoi dia chi qua may chu (task V3). Thu xong phai doi khoa.
EXPO_PUBLIC_VIETMAP_API_KEY=""

# App: dia chi may chu SeedGW. De trong thi app chay kieu ban thu, du lieu chi nam tren may.
EXPO_PUBLIC_API_URL=""

# Kho anh check-in (MinIO theo chuan S3). Bo trong thi dung MINIO_ROOT_USER, MINIO_ROOT_PASSWORD o tren.
# S3_PUBLIC_ENDPOINT la dia chi trinh duyet mo duoc anh, may chu that dat sau ten mien.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="seedgw"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
