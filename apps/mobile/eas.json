{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "thu-nghiem": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "test"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "thu-nghiem"
    },
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "test"
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "thu-nghiem"
    },
    "production": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },
    "production-ios": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "production"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appName": "SeedGW Thử"
      }
    },
    "production-ios": {
      "ios": {
        "appName": "SeedGW"
      }
    }
  }
}
