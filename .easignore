# File nay thay .gitignore khi EAS dong goi ma nguon de build app.
# Giu dong bo voi .gitignore, them nhung thu khong gui len may chu build.

node_modules/
.pnpm-store/
.turbo/
.next/
.expo/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Du lieu cuc bo cua Docker
.docker-data/

# File bien moi truong that cua may chu thu
deploy/staging/*.env

# R4: ban do va du lieu OSRM tai ve (vai GB), khong gui len may chu build
deploy/osrm/data/

# M7: tep Firebase nam o bien moi truong EAS GOOGLE_SERVICES_JSON
google-services.json
GoogleService-Info.plist

# Ghi chu rieng va tai lieu thiet ke, khong can de build app
docs/VIEC_CAN_LAM.md
.design/

# Khoa tai khoan dich vu Firebase (bi mat), chi tai len eas credentials roi xoa
*firebase-adminsdk*.json
