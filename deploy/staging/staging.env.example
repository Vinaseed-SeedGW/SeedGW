# Mẫu biến môi trường cho máy chủ thử. Chép thành /opt/dms/staging.env trên máy chủ, điền giá trị thật.
# File thật không đưa vào git. Sinh chuỗi ngẫu nhiên: openssl rand -base64 32

# Tên miền công khai trỏ về máy chủ (IT cấp), email nhận thông báo chứng chỉ.
DMS_DOMAIN="dms-thu.vinaseed.com.vn"
ACME_EMAIL="dmst-cds@vinaseed.com.vn"

# Database
POSTGRES_USER="dms"
POSTGRES_PASSWORD="doi-thanh-chuoi-ngau-nhien"
POSTGRES_DB="dms"
DATABASE_URL="postgresql://dms:doi-thanh-chuoi-ngau-nhien@postgres:5432/dms"

REDIS_URL="redis://redis:6379"

# Đăng nhập web và app. Đổi khoá này thì mọi người phải đăng nhập lại.
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien"
AUTH_URL="https://dms-thu.vinaseed.com.vn"

# Kho ảnh MinIO. S3_PUBLIC_ENDPOINT phải là https://<DMS_DOMAIN> để trình duyệt mở được ảnh.
MINIO_ROOT_USER="dms"
MINIO_ROOT_PASSWORD="doi-thanh-chuoi-ngau-nhien"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://dms-thu.vinaseed.com.vn"
S3_BUCKET="dms-photos"
S3_REGION="us-east-1"

# Mật khẩu chung của các tài khoản mẫu khi chạy seed lần đầu. Đăng nhập xong thì đổi.
SEED_PASSWORD="doi-thanh-chuoi-ngau-nhien"

# Địa chỉ từ toạ độ (V3). Khoá chỉ nằm trên máy chủ.
VIETMAP_API_KEY=""

# Bản đồ nền trang Bản đồ hành trình (V2b). Để trống thì dùng OpenStreetMap.
# Khoá này nằm trong trình duyệt người xem, dùng khoá riêng giới hạn theo tên miền.
MAP_TILE_URL=""
MAP_TILE_API_KEY=""
MAP_TILE_ATTRIBUTION=""
