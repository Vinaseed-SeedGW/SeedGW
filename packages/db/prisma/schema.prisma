generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataScope {
  OWN
  TEAM
  ORG_UNIT
  ORG_UNIT_TREE
  ALL

  @@map("data_scope")
}

model OrgUnit {
  id                      String                   @id @default(uuid()) @db.Uuid
  code                    String                   @unique
  name                    String
  parentId                String?                  @map("parent_id") @db.Uuid
  parent                  OrgUnit?                 @relation("org_unit_tree", fields: [parentId], references: [id])
  children                OrgUnit[]                @relation("org_unit_tree")
  managerId               String?                  @map("manager_id") @db.Uuid
  manager                 User?                    @relation("org_unit_manager", fields: [managerId], references: [id], onDelete: SetNull)
  // Co cap Quan ly (quyet dinh 31): bat thi phieu Tuyen, Chi tieu qua Quan ly truoc Lanh dao don vi.
  hasManagerLevel         Boolean                  @default(false) @map("has_manager_level")
  // S8: kiểu tuyến NVKD trong đơn vị đăng ký, mặc định theo tuần.
  routeKind               RouteKind                @default(WEEKLY) @map("route_kind")
  routePlans              RoutePlan[]
  users                   User[]                   @relation("org_unit_members")
  checkIns                CheckIn[]
  dealers                 Dealer[]
  dealerLocationProposals DealerLocationProposal[]
  dealerProposals         DealerProposal[]
  approvalRequests        ApprovalRequest[]
  monthlySalesTargets     MonthlySalesTarget[]
  assignedSalesTargets    AssignedSalesTarget[]
  supportRequests         SupportRequest[]
  // K7: tỉnh đơn vị phụ trách.
  provinces               OrgUnitProvince[]
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@map("org_units")
}

enum MobileDeviceStatus {
  PENDING
  ACTIVE
  REVOKED

  @@map("mobile_device_status")
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  employeeCode           String                   @unique @map("employee_code")
  fullName               String                   @map("full_name")
  passwordHash           String                   @map("password_hash")
  isActive               Boolean                  @default(true) @map("is_active")
  // Cot do PostgreSQL tu tinh, khong ghi tu ung dung.
  searchText             String?                  @default(dbgenerated()) @map("search_text")
  phone                  String?
  email                  String?
  jobTitle               String?                  @map("job_title")
  hiredAt                DateTime?                @map("hired_at") @db.Date
  orgUnitId              String?                  @map("org_unit_id") @db.Uuid
  orgUnit                OrgUnit?                 @relation("org_unit_members", fields: [orgUnitId], references: [id])
  managerId              String?                  @map("manager_id") @db.Uuid
  manager                User?                    @relation("user_manager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          User[]                   @relation("user_manager")
  mustChangePassword     Boolean                  @default(false) @map("must_change_password")
  failedLoginCount       Int                      @default(0) @map("failed_login_count")
  failedLoginStartedAt   DateTime?                @map("failed_login_started_at")
  loginLockedUntil       DateTime?                @map("login_locked_until")
  // Tang len de thu hoi moi phien da cap, ke ca phien tren dien thoai.
  sessionVersion         Int                      @default(0) @map("session_version")
  managedUnits           OrgUnit[]                @relation("org_unit_manager")
  roles                  UserRole[]
  auditLogs              AuditLog[]               @relation("audit_actor")
  impersonatedAuditLogs  AuditLog[]               @relation("audit_impersonator")
  mobileDevices          MobileDevice[]
  impersonationsStarted  ImpersonationSession[]   @relation("impersonation_actor")
  impersonationsReceived ImpersonationSession[]   @relation("impersonation_target")
  mobileRefreshTokens    MobileRefreshToken[]
  checkIns               CheckIn[]
  dailyVisitStats        DailyVisitStat[]
  trackPoints            TrackPoint[]
  trackSessions          TrackSession[]
  assignedDealers        Dealer[]                 @relation("dealer_assignee")
  locationProposals      DealerLocationProposal[] @relation("dealer_location_proposer")
  locationReviews        DealerLocationProposal[] @relation("dealer_location_reviewer")
  dealerProposals        DealerProposal[]         @relation("dealer_proposer")
  dealerProposalReviews  DealerProposal[]         @relation("dealer_proposal_reviewer")
  consents               UserConsent[]
  submittedApprovals     ApprovalRequest[]        @relation("approval_submitter")
  pendingApprovals       ApprovalRequest[]        @relation("approval_current_approver")
  managerApprovals       ApprovalRequest[]        @relation("approval_manager_approver")
  leaderApprovals        ApprovalRequest[]        @relation("approval_leader_approver")
  approvalActions        ApprovalAction[]         @relation("approval_actor")
  monthlySalesTargets    MonthlySalesTarget[]
  assignedSalesTargets   AssignedSalesTarget[]    @relation("target_assignee")
  givenSalesTargets      AssignedSalesTarget[]    @relation("target_assigner")
  routePlans             RoutePlan[]
  supportRequests        SupportRequest[]         @relation("support_requester")
  assignedSupport        SupportRequest[]         @relation("support_assignee")
  supportMessages        SupportMessage[]
  supportEvents          SupportEvent[]
  supportReads           SupportRead[]
  pushTokens             PushToken[]
  pushMessages           PushMessage[]
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_search_text_trgm_idx")
  @@index([managerId])
  @@map("users")
}

model MobileDevice {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKey          String               @map("device_key")
  name               String
  platform           String
  status             MobileDeviceStatus   @default(PENDING)
  approvedAt         DateTime?            @map("approved_at")
  revokedAt          DateTime?            @map("revoked_at")
  lastSeenAt         DateTime?            @map("last_seen_at")
  // M5: app báo máy đã root hoặc jailbreak; null là chưa rõ (app cũ).
  isRooted           Boolean?             @map("is_rooted")
  integrityCheckedAt DateTime?            @map("integrity_checked_at")
  refreshTokens      MobileRefreshToken[]
  checkIns           CheckIn[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@unique([userId, deviceKey])
  @@index([userId, status])
  @@map("mobile_devices")
}

model ImpersonationSession {
  id        String    @id @default(uuid()) @db.Uuid
  actorId   String    @map("actor_id") @db.Uuid
  actor     User      @relation("impersonation_actor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId  String    @map("target_id") @db.Uuid
  target    User      @relation("impersonation_target", fields: [targetId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([actorId, endedAt])
  @@map("impersonation_sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actor          User?    @relation("audit_actor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonatorId String?  @map("impersonator_id") @db.Uuid
  impersonator   User?    @relation("audit_impersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  entityLabel    String   @map("entity_label")
  changes        Json
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model CodeSequence {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  prefix     String
  digits     Int
  rangeStart Int      @map("range_start")
  rangeEnd   Int      @map("range_end")
  nextValue  Int      @map("next_value")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("code_sequences")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  dataScope   DataScope    @default(OWN) @map("data_scope")
  permissions Permission[] @relation("role_permissions")
  users       UserRole[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique
  name  String
  roles Role[] @relation("role_permissions")

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Phien dang nhap app: luu bam cua refresh token, doi token moi lan lam moi.
model MobileRefreshToken {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String       @map("device_id") @db.Uuid
  device         MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @map("token_hash")
  // Doi mat khau, khoa tai khoan lam tang sessionVersion cua User, token cu khong dung duoc nua.
  sessionVersion Int          @map("session_version")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@map("mobile_refresh_tokens")
}

enum CheckInPlaceKind {
  DEALER
  CUSTOMER
  OTHER

  @@map("check_in_place_kind")
}

// K1: lượt ghé thăm gộp theo ngày (giờ Việt Nam), đơn vị và nhân viên lúc check-in, loại điểm, tỉnh của đại lý.
// Worker tính lại 15 phút một lần cho ngày có check-in mới và mỗi đêm cho 7 ngày gần nhất; Dashboard đọc bảng này
// cho các ngày đã qua, ngày hôm nay vẫn đếm thẳng từ check_ins.
model DailyVisitStat {
  id           String           @id @default(uuid()) @db.Uuid
  day          DateTime         @db.Date
  orgUnitId    String?          @map("org_unit_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeKind    CheckInPlaceKind @map("place_kind")
  provinceName String?          @map("province_name")
  visits       Int
  flagged      Int
  roadKm       Float            @map("road_km")
  roadVisits   Int              @map("road_visits")
  gpsKm        Float            @map("gps_km")
  gpsVisits    Int              @map("gps_visits")
  computedAt   DateTime         @default(now()) @map("computed_at")

  @@index([day])
  @@index([userId, day])
  @@index([orgUnitId, day])
  @@map("daily_visit_stats")
}

model CheckIn {
  id                  String                  @id @default(uuid()) @db.Uuid
  // Ma app tao truoc khi gui, goi lai cung ma khong tao them dong.
  clientId            String                  @unique @map("client_id") @db.Uuid
  userId              String                  @map("user_id") @db.Uuid
  user                User                    @relation(fields: [userId], references: [id])
  // Don vi cua nhan vien tai thoi diem check-in, doi don vi sau nay khong lam doi bao cao cu.
  orgUnitId           String?                 @map("org_unit_id") @db.Uuid
  orgUnit             OrgUnit?                @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  deviceId            String?                 @map("device_id") @db.Uuid
  device              MobileDevice?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  // Có khi check-in tại đại lý chọn từ danh mục (A7). placeName vẫn giữ tên lúc check-in.
  dealerId            String?                 @map("dealer_id") @db.Uuid
  dealer              Dealer?                 @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  capturedAt          DateTime                @map("captured_at")
  receivedAt          DateTime                @default(now()) @map("received_at")
  lat                 Float
  lng                 Float
  accuracyM           Float?                  @map("accuracy_m")
  isMocked            Boolean                 @map("is_mocked")
  placeKind           CheckInPlaceKind        @map("place_kind")
  placeName           String                  @map("place_name")
  note                String                  @default("")
  address             String?
  addressOnPhoto      String?                 @map("address_on_photo")
  addressAttempts     Int                     @default(0) @map("address_attempts")
  photoKey            String?                 @map("photo_key")
  photoBytes          Int?                    @map("photo_bytes")
  gpsDistanceKm       Float?                  @map("gps_distance_km")
  roadDistanceKm      Float?                  @map("road_distance_km")
  // V1b: chặng có đoạn nối bằng đường ngắn nhất (mất vết, không khớp được); lúc tính xong lần gần nhất.
  isRoadEstimated     Boolean                 @default(false) @map("is_road_estimated")
  roadComputedAt      DateTime?               @map("road_computed_at")
  isDistanceEstimated Boolean                 @default(false) @map("is_distance_estimated")
  flags               String[]                @default([])
  // Khoang cach toi toa do dai ly da duyet (M4), null khi dai ly chua co toa do.
  dealerDistanceM     Float?                  @map("dealer_distance_m")
  // Ly do nhan vien nhap khi check-in xa dai ly qua ban kinh trong Tham so.
  farReason           String?                 @map("far_reason")
  locationProposal    DealerLocationProposal?
  dealerProposal      DealerProposal?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  @@index([userId, capturedAt(sort: Desc)])
  @@index([orgUnitId, capturedAt(sort: Desc)])
  @@index([capturedAt(sort: Desc)])
  @@index([dealerId, capturedAt(sort: Desc)])
  @@map("check_ins")
}

model TrackPoint {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt   DateTime @map("recorded_at")
  lat          Float
  lng          Float
  accuracyM    Float?   @map("accuracy_m")
  speedMps     Float?   @map("speed_mps")
  isMocked     Boolean  @map("is_mocked")
  isBackground Boolean  @map("is_background")
  receivedAt   DateTime @default(now()) @map("received_at")

  @@unique([userId, recordedAt])
  @@map("track_points")
}

enum TrackSessionEndReason {
  USER
  AUTO_CUTOFF

  @@map("track_session_end_reason")
}

// Khoang thoi gian app dang ghi hanh trinh. Khong cong km noi giua hai phien.
model TrackSession {
  id        String                 @id @default(uuid()) @db.Uuid
  clientId  String                 @unique @map("client_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime               @map("started_at")
  endedAt   DateTime?              @map("ended_at")
  endReason TrackSessionEndReason? @map("end_reason")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@index([userId, startedAt])
  @@map("track_sessions")
}

enum DealerStatus {
  ACTIVE
  INACTIVE

  @@map("dealer_status")
}

// Danh muc dai ly (A7). code la ma khach hang tren FAST, legacyCode la ma he thong cu.
model Dealer {
  id                 String                   @id @default(uuid()) @db.Uuid
  code               String?                  @unique
  legacyCode         String?                  @unique @map("legacy_code")
  name               String
  level              Int
  parentId           String?                  @map("parent_id") @db.Uuid
  parent             Dealer?                  @relation("dealer_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Dealer[]                 @relation("dealer_tree")
  taxCode            String?                  @map("tax_code")
  status             DealerStatus             @default(ACTIVE)
  phone              String?
  // So dien thoai goc khi khong dung dinh dang, de nguoi dung sua lai.
  phoneRaw           String?                  @map("phone_raw")
  ownerName          String?                  @map("owner_name")
  ownerPhone         String?                  @map("owner_phone")
  address            String
  provinceName       String?                  @map("province_name")
  // Tinh, huyen, xa cu (truoc 01/07/2025) dung nguyen van tu he thong cu de tham khao.
  legacyAdminArea    String?                  @map("legacy_admin_area")
  lat                Float?
  lng                Float?
  locatedAt          DateTime?                @map("located_at")
  // Lan check-in gan nhat tai dai ly (K0), cap nhat khi luu check-in, de dashboard khong phai do toan bo check-in.
  lastVisitedAt      DateTime?                @map("last_visited_at")
  orgUnitId          String?                  @map("org_unit_id") @db.Uuid
  orgUnit            OrgUnit?                 @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  assignedUserId     String?                  @map("assigned_user_id") @db.Uuid
  assignedUser       User?                    @relation("dealer_assignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // Ten don vi va nguoi phu trach ghi tren he thong cu, de ghep lai khi doi co cau hoac nhap them tai khoan.
  legacyOrgUnitName  String?                  @map("legacy_org_unit_name")
  legacyAssigneeName String?                  @map("legacy_assignee_name")
  // A7b: đại lý đã gộp vào đại lý khác (chuyển Ngừng hoạt động, không xoá).
  mergedIntoId       String?                  @map("merged_into_id") @db.Uuid
  mergedInto         Dealer?                  @relation("dealer_merged", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom         Dealer[]                 @relation("dealer_merged")
  mergesKept         DealerMerge[]            @relation("dealer_merge_kept")
  mergesMerged       DealerMerge[]            @relation("dealer_merge_merged")
  // Cot do PostgreSQL tu tinh, khong ghi tu ung dung.
  searchText         String?                  @default(dbgenerated()) @map("search_text")
  checkIns           CheckIn[]
  routeStops         RoutePlanStop[]
  // A8: bản ghi khách hàng FAST đã ghép với đại lý này.
  fastCustomer       FastCustomer?
  locationProposals  DealerLocationProposal[]
  // M10: đề xuất đã tạo ra đại lý này, hoặc đề xuất bị đánh dấu trùng với đại lý này.
  proposals          DealerProposal[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "dealers_search_text_trgm_idx")
  @@index([orgUnitId])
  @@index([assignedUserId])
  @@index([parentId])
  @@index([provinceName])
  @@index([status, level, lastVisitedAt])
  @@map("dealers")
}

enum DealerLocationProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("dealer_location_proposal_status")
}

// De xuat toa do dai ly tu lan check-in dau tai dai ly chua co toa do (M4), Quan tri don vi duyet.
// Moi dai ly chi co mot de xuat cho duyet, rang buoc nay viet bang SQL (unique index co dieu kien).
model DealerLocationProposal {
  id           String                       @id @default(uuid()) @db.Uuid
  dealerId     String                       @map("dealer_id") @db.Uuid
  dealer       Dealer                       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  // Don vi phu trach dai ly luc de xuat, de Quan tri don vi thay de xuat trong pham vi cua minh.
  orgUnitId    String?                      @map("org_unit_id") @db.Uuid
  orgUnit      OrgUnit?                     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  checkInId    String                       @unique @map("check_in_id") @db.Uuid
  checkIn      CheckIn                      @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  proposedById String                       @map("proposed_by_id") @db.Uuid
  proposedBy   User                         @relation("dealer_location_proposer", fields: [proposedById], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracyM    Float?                       @map("accuracy_m")
  status       DealerLocationProposalStatus @default(PENDING)
  reviewedById String?                      @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?                        @relation("dealer_location_reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?                    @map("reviewed_at")
  reviewNote   String                       @default("") @map("review_note")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  @@index([status, orgUnitId, createdAt(sort: Desc)])
  @@index([dealerId])
  @@map("dealer_location_proposals")
}

// M10 (20/11/2026): đề xuất đại lý mới từ app, đi kèm một lượt check-in tại cửa hàng.
enum DealerProposalStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE

  @@map("dealer_proposal_status")
}

model DealerProposal {
  id           String               @id @default(uuid()) @db.Uuid
  // Lượt check-in mang ảnh, toạ độ, giờ và địa chỉ lúc chụp. Một check-in chỉ có một đề xuất.
  checkInId    String               @unique @map("check_in_id") @db.Uuid
  checkIn      CheckIn              @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  // Đơn vị của nhân viên lúc đề xuất, để Quản trị đơn vị thấy đề xuất trong phạm vi của mình.
  orgUnitId    String?              @map("org_unit_id") @db.Uuid
  orgUnit      OrgUnit?             @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  proposedById String               @map("proposed_by_id") @db.Uuid
  proposedBy   User                 @relation("dealer_proposer", fields: [proposedById], references: [id], onDelete: Cascade)
  name         String
  phone        String
  address      String
  ownerName    String?              @map("owner_name")
  taxCode      String?              @map("tax_code")
  level        Int
  status       DealerProposalStatus @default(PENDING)
  // Đại lý tạo khi duyệt, hoặc đại lý có sẵn khi đánh dấu trùng.
  dealerId     String?              @map("dealer_id") @db.Uuid
  dealer       Dealer?              @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?                @relation("dealer_proposal_reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?            @map("reviewed_at")
  reviewNote   String               @default("") @map("review_note")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([status, orgUnitId, createdAt(sort: Desc)])
  @@index([proposedById, createdAt(sort: Desc)])
  @@index([phone])
  @@map("dealer_proposals")
}

enum ConsentChannel {
  WEB
  APP

  @@map("consent_channel")
}

// Loi dong y cua nguoi dung theo tung phien ban cau chu (17/11/2026: dong y chia se vi tri).
// Rut lai thi ghi withdrawnAt, dong y lai thi xoa withdrawnAt va cap nhat acceptedAt.
model UserConsent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  version     String
  channel     ConsentChannel
  acceptedAt  DateTime       @default(now()) @map("accepted_at")
  withdrawnAt DateTime?      @map("withdrawn_at")
  ip          String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([userId, kind, version])
  @@map("user_consents")
}

enum ApprovalKind {
  ROUTE_PLAN
  SALES_TARGET

  @@map("approval_kind")
}

enum ApprovalStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_LEADER
  RETURNED
  APPROVED
  WITHDRAWN

  @@map("approval_status")
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  RETURN
  WITHDRAW
  AUTO_PASS
  SKIP_STEP
  REASSIGN

  @@map("approval_action_type")
}

enum ApprovalStep {
  MANAGER
  LEADER

  @@map("approval_step")
}

// Ho so phe duyet dung chung cho Tuyen (S8) va Chi tieu thang (K3a) theo quyet dinh 31.
model ApprovalRequest {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique
  kind              ApprovalKind
  subjectId         String           @map("subject_id") @db.Uuid
  submittedById     String           @map("submitted_by_id") @db.Uuid
  submittedBy       User             @relation("approval_submitter", fields: [submittedById], references: [id], onDelete: Cascade)
  orgUnitId         String?          @map("org_unit_id") @db.Uuid
  orgUnit           OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  status            ApprovalStatus   @default(DRAFT)
  currentApproverId String?          @map("current_approver_id") @db.Uuid
  currentApprover   User?            @relation("approval_current_approver", fields: [currentApproverId], references: [id], onDelete: SetNull)
  managerApproverId String?          @map("manager_approver_id") @db.Uuid
  managerApprover   User?            @relation("approval_manager_approver", fields: [managerApproverId], references: [id], onDelete: SetNull)
  leaderApproverId  String?          @map("leader_approver_id") @db.Uuid
  leaderApprover    User?            @relation("approval_leader_approver", fields: [leaderApproverId], references: [id], onDelete: SetNull)
  periodStart       DateTime         @map("period_start")
  periodEnd         DateTime         @map("period_end")
  periodLabel       String           @map("period_label")
  summaryText       String           @default("") @map("summary_text")
  isLate            Boolean          @default(false) @map("is_late")
  submissionCount   Int              @default(0) @map("submission_count")
  submittedAt       DateTime?        @map("submitted_at")
  decidedAt         DateTime?        @map("decided_at")
  actions           ApprovalAction[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([kind, subjectId])
  @@index([currentApproverId, status])
  @@index([orgUnitId, status, submittedAt(sort: Desc)])
  @@index([submittedById, kind, status])
  @@map("approval_requests")
}

model ApprovalAction {
  id        String             @id @default(uuid()) @db.Uuid
  requestId String             @map("request_id") @db.Uuid
  request   ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?            @map("actor_id") @db.Uuid
  actor     User?              @relation("approval_actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    ApprovalActionType
  step      ApprovalStep?
  note      String             @default("")
  snapshot  Json?
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([requestId, createdAt(sort: Asc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("approval_actions")
}

// Chi tieu thang tu dang ky cua NVKD (K3a), duyet qua luong A10b.
model MonthlySalesTarget {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnitId              String?   @map("org_unit_id") @db.Uuid
  orgUnit                OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  month                  String
  visitCountTarget       Int       @map("visit_count_target")
  dealerCoverageTarget   Int       @map("dealer_coverage_target")
  salesKgTarget          Float     @default(0) @map("sales_kg_target")
  note                   String    @default("")
  // Ban dang hieu luc. Sua chi tieu da duyet thi cac cot tren la ban de nghi, cot approved giu nguyen den khi duyet xong.
  approvedVisitCount     Int?      @map("approved_visit_count")
  approvedDealerCoverage Int?      @map("approved_dealer_coverage")
  approvedSalesKg        Float?    @map("approved_sales_kg")
  approvedAt             DateTime? @map("approved_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@index([orgUnitId, month])
  @@map("monthly_sales_targets")
}

// K3 (23/11/2026): chỉ tiêu tháng giao từ trên xuống cho đơn vị hoặc nhân viên. Có chỉ tiêu được giao thì
// thay chỉ tiêu nhân viên tự đăng ký (MonthlySalesTarget) của tháng đó.
enum TargetAssigneeKind {
  UNIT
  USER

  @@map("target_assignee_kind")
}

model AssignedSalesTarget {
  id                   String             @id @default(uuid()) @db.Uuid
  month                String
  kind                 TargetAssigneeKind
  // Đơn vị được giao (UNIT), hoặc đơn vị của nhân viên lúc giao (USER) để áp phạm vi dữ liệu.
  orgUnitId            String?            @map("org_unit_id") @db.Uuid
  orgUnit              OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  userId               String?            @map("user_id") @db.Uuid
  user                 User?              @relation("target_assignee", fields: [userId], references: [id], onDelete: Cascade)
  visitCountTarget     Int                @map("visit_count_target")
  dealerCoverageTarget Int                @map("dealer_coverage_target")
  // Thực bán (kg) dùng khi nối FAST.
  salesKgTarget        Float              @default(0) @map("sales_kg_target")
  note                 String             @default("")
  assignedById         String             @map("assigned_by_id") @db.Uuid
  assignedBy           User               @relation("target_assigner", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([month, orgUnitId])
  @@index([month, userId])
  @@map("assigned_sales_targets")
}

// K3: lịch vụ chung toàn công ty, lặp lại mọi năm (đổi 23/11/2026). Kết thúc trước bắt đầu trong năm là vụ
// sang năm sau, ví dụ 05/11 tới 15/03.
model Season {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  startDay   Int      @map("start_day")
  startMonth Int      @map("start_month")
  endDay     Int      @map("end_day")
  endMonth   Int      @map("end_month")
  // K7: vụ của một vùng canh tác; null là vụ chung, chọn được ở mọi vùng.
  regionId   String?  @map("region_id") @db.Uuid
  region     Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  note       String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("seasons")
}

// K7: vùng canh tác (Đồng bằng sông Hồng, Tây Nguyên...), khác Miền, Vùng trong cơ cấu tổ chức.
model Region {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  sortOrder Int              @map("sort_order")
  provinces ProvinceRegion[]
  seasons   Season[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("regions")
}

// Mỗi tỉnh mới (34 tỉnh) thuộc một vùng.
model ProvinceRegion {
  provinceName String   @id @map("province_name")
  regionId     String   @map("region_id") @db.Uuid
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("province_regions")
}

// Tỉnh đơn vị phụ trách; một đơn vị nhiều tỉnh, một tỉnh nhiều đơn vị.
model OrgUnitProvince {
  orgUnitId    String   @map("org_unit_id") @db.Uuid
  orgUnit      OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  provinceName String   @map("province_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([orgUnitId, provinceName])
  @@index([provinceName])
  @@map("org_unit_provinces")
}

enum RouteKind {
  WEEKLY
  DAILY

  @@map("route_kind")
}

// S8: tuyến của một người cho một kỳ (tuần bắt đầu thứ Hai, hoặc một ngày). Mỗi lần gửi tạo bản điểm mới
// (revision); bản đã duyệt giữ nguyên tới khi bản sửa được duyệt.
model RoutePlan {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnitId        String?         @map("org_unit_id") @db.Uuid
  orgUnit          OrgUnit?        @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  kind             RouteKind
  periodStart      String          @map("period_start")
  note             String          @default("")
  currentRevision  Int             @default(0) @map("current_revision")
  approvedRevision Int?            @map("approved_revision")
  approvedAt       DateTime?       @map("approved_at")
  stops            RoutePlanStop[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([userId, kind, periodStart])
  @@index([orgUnitId, periodStart])
  @@map("route_plans")
}

model RoutePlanStop {
  id       String    @id @default(uuid()) @db.Uuid
  planId   String    @map("plan_id") @db.Uuid
  plan     RoutePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  revision Int
  day      String
  position Int
  dealerId String    @map("dealer_id") @db.Uuid
  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([planId, revision, day, position])
  @@index([dealerId])
  @@map("route_plan_stops")
}

// A7b: lịch sử gộp đại lý trùng, đủ để khôi phục tay khi cần.
model DealerMerge {
  id             String   @id @default(uuid()) @db.Uuid
  keptId         String   @map("kept_id") @db.Uuid
  kept           Dealer   @relation("dealer_merge_kept", fields: [keptId], references: [id], onDelete: Cascade)
  mergedId       String   @map("merged_id") @db.Uuid
  merged         Dealer   @relation("dealer_merge_merged", fields: [mergedId], references: [id], onDelete: Cascade)
  actorId        String?  @map("actor_id") @db.Uuid
  movedCheckIns  Int      @default(0) @map("moved_check_ins")
  movedStops     Int      @default(0) @map("moved_stops")
  movedProposals Int      @default(0) @map("moved_proposals")
  movedChildren  Int      @default(0) @map("moved_children")
  filledFields   String[] @default([]) @map("filled_fields")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([keptId])
  @@index([mergedId])
  @@map("dealer_merges")
}

// A7b: nhóm cùng số điện thoại hoặc mã số thuế đã xem và xác nhận không phải đại lý trùng.
model DealerDuplicateDismissal {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String
  value         String
  dismissedById String?  @map("dismissed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([kind, value])
  @@map("dealer_duplicate_dismissals")
}

// ---------- Hỗ trợ (T1 tới T5, quyết định 29, 30) ----------

enum SupportType {
  QUESTION
  BUG
  FEEDBACK

  @@map("support_type")
}

enum SupportSeverity {
  BLOCKER
  MAJOR
  MINOR

  @@map("support_severity")
}

enum SupportStatus {
  NEW
  IN_PROGRESS
  WAITING_REQUESTER
  DONE
  CLOSED

  @@map("support_status")
}

enum SupportLevel {
  UNIT
  SYSTEM

  @@map("support_level")
}

enum SupportEventKind {
  CREATE
  CLAIM
  ESCALATE
  STATUS
  REOPEN
  AUTO_CLOSE

  @@map("support_event_kind")
}

// Yêu cầu hỗ trợ CBNV gửi quản trị. Đơn vị chụp lúc gửi để hộp chung không đổi khi người gửi chuyển đơn vị.
model SupportRequest {
  id                      String           @id @default(uuid()) @db.Uuid
  code                    String           @unique
  // App tạo khi soạn, gửi lại lúc có mạng không tạo trùng.
  clientId                String           @map("client_id") @db.Uuid
  requesterId             String           @map("requester_id") @db.Uuid
  requester               User             @relation("support_requester", fields: [requesterId], references: [id], onDelete: Cascade)
  orgUnitId               String?          @map("org_unit_id") @db.Uuid
  orgUnit                 OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  type                    SupportType
  severity                SupportSeverity?
  title                   String
  status                  SupportStatus    @default(NEW)
  level                   SupportLevel     @default(UNIT)
  assigneeId              String?          @map("assignee_id") @db.Uuid
  assignee                User?            @relation("support_assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  context                 Json             @default("{}")
  escalationNote          String?          @map("escalation_note")
  escalatedAt             DateTime?        @map("escalated_at")
  firstResponseAt         DateTime?        @map("first_response_at")
  firstResponseDueAt      DateTime?        @map("first_response_due_at")
  resolveDueAt            DateTime?        @map("resolve_due_at")
  resolvedAt              DateTime?        @map("resolved_at")
  closedAt                DateTime?        @map("closed_at")
  // Người gửi trả lời sau lần trả lời cuối của bên xử lý thì yêu cầu cần xử lý.
  lastRequesterActivityAt DateTime         @map("last_requester_activity_at")
  lastHandlerActivityAt   DateTime?        @map("last_handler_activity_at")
  // Không còn dùng từ 19/11/2026 (bỏ Mattermost), giữ cột để không phải xoá dữ liệu.
  overdueAlertedAt        DateTime?        @map("overdue_alerted_at")
  // Đã xoá nội dung và tệp sau 18 tháng (T5), chỉ giữ số liệu thống kê.
  purgedAt                DateTime?        @map("purged_at")
  messages                SupportMessage[]
  events                  SupportEvent[]
  reads                   SupportRead[]
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, clientId])
  @@index([requesterId, updatedAt(sort: Desc)])
  @@index([orgUnitId, status])
  @@index([level, status])
  @@index([assigneeId, status])
  @@index([status, resolvedAt])
  @@index([createdAt])
  @@map("support_requests")
}

model SupportMessage {
  id            String              @id @default(uuid()) @db.Uuid
  requestId     String              @map("request_id") @db.Uuid
  request       SupportRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId      String              @map("client_id") @db.Uuid
  authorId      String?             @map("author_id") @db.Uuid
  author        User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromRequester Boolean             @map("from_requester")
  body          String              @default("")
  attachments   SupportAttachment[]
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([requestId, clientId])
  @@index([requestId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id         String         @id @default(uuid()) @db.Uuid
  messageId  String         @map("message_id") @db.Uuid
  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // App gửi từng tệp sau tin nhắn, gửi lại không tạo trùng.
  clientId   String?        @map("client_id") @db.Uuid
  storageKey String         @map("storage_key")
  fileName   String         @map("file_name")
  mimeType   String         @map("mime_type")
  sizeBytes  Int            @map("size_bytes")
  isImage    Boolean        @map("is_image")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@unique([messageId, clientId])
  @@index([messageId])
  @@map("support_attachments")
}

model SupportEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @map("request_id") @db.Uuid
  request    SupportRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId    String?          @map("actor_id") @db.Uuid
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind       SupportEventKind
  fromStatus SupportStatus?   @map("from_status")
  toStatus   SupportStatus?   @map("to_status")
  note       String           @default("")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("support_events")
}

// Lần cuối mỗi người xem yêu cầu, để đếm trả lời chưa đọc.
model SupportRead {
  requestId  String         @map("request_id") @db.Uuid
  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime       @map("last_read_at")

  @@id([requestId, userId])
  @@index([userId])
  @@map("support_reads")
}

// Nhật ký gửi ra hệ thống ngoài (chiều SeedGW gọi FAST, làm sau): chống gửi trùng theo khoá, ghi lỗi để gửi lại.
model IntegrationLog {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  idempotencyKey String    @unique @map("idempotency_key")
  status         String
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  payload        Json
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([provider, status])
  @@map("integration_logs")
}

// ---------- Kết nối FAST (A8, 19/11/2026) ----------

// Cấu hình kết nối ra ngoài, giá trị mã hoá AES-256-GCM bằng INTEGRATION_SECRET_KEY, không lưu mật khẩu dạng rõ.
model IntegrationSetting {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}

enum FastSyncStatus {
  RUNNING
  OK
  FAILED
  SKIPPED

  @@map("fast_sync_status")
}

// Mỗi lần lấy danh mục khách hàng từ FAST: mốc lấy, số dòng, lỗi.
model FastSyncRun {
  id         String          @id @default(uuid()) @db.Uuid
  trigger    String
  status     FastSyncStatus  @default(RUNNING)
  // Lấy khách hàng sửa từ mốc này; null là lấy toàn bộ.
  sinceAt    DateTime?       @map("since_at")
  // Ngày sửa lớn nhất nhận được, làm mốc cho lần sau.
  cursorAt   DateTime?       @map("cursor_at")
  fetched    Int             @default(0)
  created    Int             @default(0)
  updated    Int             @default(0)
  unchanged  Int             @default(0)
  failed     Int             @default(0)
  message    String?
  startedAt  DateTime        @default(now()) @map("started_at")
  finishedAt DateTime?       @map("finished_at")
  errors     FastSyncError[]

  @@index([startedAt(sort: Desc)])
  @@map("fast_sync_runs")
}

model FastSyncError {
  id        String      @id @default(uuid()) @db.Uuid
  runId     String      @map("run_id") @db.Uuid
  run       FastSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fastCode  String?     @map("fast_code")
  message   String
  payload   Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([runId])
  @@map("fast_sync_errors")
}

// Bản sao danh mục khách hàng FAST, giữ nguyên trường gốc để sau này phân loại lại (đại lý, khách hàng khác).
model FastCustomer {
  code          String    @id
  name          String
  taxCode       String?   @map("tax_code")
  address       String?
  provinceCode  String?   @map("province_code")
  districtCode  String?   @map("district_code")
  phone         String?
  email         String?
  unitCode      String?   @map("unit_code")
  groups        Json      @default("{}")
  status        String?
  fastCreatedAt DateTime? @map("fast_created_at")
  fastUpdatedAt DateTime? @map("fast_updated_at")
  dealerId      String?   @unique @map("dealer_id") @db.Uuid
  dealer        Dealer?   @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  syncedAt      DateTime  @map("synced_at")

  @@index([fastUpdatedAt])
  @@map("fast_customers")
}

// ---------- Thông báo đẩy (M7, 19/11/2026) ----------

// Mã nhận thông báo Expo của từng máy. Một máy một mã; đăng xuất hoặc Expo báo hết hiệu lực thì xoá.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?  @map("device_id") @db.Uuid
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @map("last_seen_at")

  @@index([userId])
  @@map("push_tokens")
}

// Nhật ký thông báo: khoá chống gửi trùng theo việc và người nhận, trạng thái gửi, lỗi.
model PushMessage {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String
  data           Json      @default("{}")
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("PENDING")
  error          String?
  attempts       Int       @default(0)
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("push_messages")
}
