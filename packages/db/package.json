{
  "name": "@seedgw/db",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./daily-visit-stats": "./src/daily-visit-stats.ts",
    "./integration-settings": "./src/integration-settings.ts",
    "./org-units": "./src/org-units.ts",
    "./scoped-client": "./src/scoped-client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy:migrations": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seedgw/contracts": "workspace:*",
    "@prisma/client": "~6.19.3"
  },
  "devDependencies": {
    "@seedgw/config": "workspace:*",
    "@types/node": "^24",
    "argon2": "^0.45.2",
    "dotenv-cli": "^11.1.0",
    "prisma": "~6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
