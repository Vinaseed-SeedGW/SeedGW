# Mẫu biến môi trường cho máy chủ thật. Chép thành /opt/seedgw/production.env trên máy ảo Ubuntu, điền giá trị
# thật, chmod 600. File thật không đưa vào git. Sinh chuỗi ngẫu nhiên: openssl rand -base64 32
# Mọi khoá dưới đây phải KHÁC máy chủ thử, không chép từ deploy/staging/local-test.env.

# Địa chỉ IIS chuyển tiếp vào máy này (Windows Server 10.10.8.35). Caddy chỉ tin IP người dùng do IIS gửi.
IIS_PROXY_IP="10.10.8.35"

# Database
POSTGRES_USER="seedgw"
POSTGRES_PASSWORD="doi-thanh-chuoi-ngau-nhien"
POSTGRES_DB="seedgw"
DATABASE_URL="postgresql://seedgw:doi-thanh-chuoi-ngau-nhien@postgres:5432/seedgw"

REDIS_URL="redis://redis:6379"

# Đăng nhập web và app. Đổi khoá này thì mọi người phải đăng nhập lại.
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien"
AUTH_URL="https://seedgw.vinaseed.com.vn"
# Khoá mã hoá cấu hình kết nối FAST (A8), tạo bằng: openssl rand -base64 48
# Khoá mới thì cấu hình FAST chuyển từ máy chủ thử không giải mã được, nhập lại ở Quản trị, Kết nối.
INTEGRATION_SECRET_KEY="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# Kho ảnh MinIO. S3_PUBLIC_ENDPOINT là tên miền công khai để trình duyệt và app mở được ảnh.
MINIO_ROOT_USER="seedgw"
MINIO_ROOT_PASSWORD="doi-thanh-chuoi-ngau-nhien"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://seedgw.vinaseed.com.vn"
S3_BUCKET="seedgw-photos"
S3_REGION="us-east-1"

# Máy chủ tìm đường (km theo đường đi). Để trống thì tính km theo GPS. Bật OSRM thì đặt http://osrm:5000
# và chạy compose kèm --profile osrm.
OSRM_URL=""

# Địa chỉ từ toạ độ (V3). Khoá mới đứng tên Vinaseed, chỉ nằm trên máy chủ.
VIETMAP_API_KEY=""

# Gửi thông báo đẩy qua Expo. Để trống nếu dự án Expo chưa bật bảo mật gửi thông báo.
EXPO_ACCESS_TOKEN=""

# Bản đồ nền trang Bản đồ hành trình (V2b). Để trống thì dùng OpenStreetMap.
MAP_TILE_URL=""
MAP_TILE_API_KEY=""
MAP_TILE_ATTRIBUTION=""
