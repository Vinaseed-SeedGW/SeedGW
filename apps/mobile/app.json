{
  "expo": {
    "name": "SeedGW",
    "slug": "check-in-app",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/app-icon.png",
    "ios": {
      "bundleIdentifier": "vn.vinaseed.seedgw",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "vi",
        "CFBundleLocalizations": ["vi"]
      }
    },
    "android": {
      "package": "vn.vinaseed.seedgw",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "backgroundColor": "#005b36"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "SeedGW dùng máy ảnh để chụp ảnh check-in tại đại lý, khách hàng hoặc điểm làm việc. Ảnh có in giờ và vị trí.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SeedGW dùng vị trí để ghi điểm check-in và in toạ độ lên ảnh check-in.",
          "locationAlwaysAndWhenInUsePermission": "SeedGW ghi vị trí trong giờ làm việc, từ lượt check-in đầu tiên tới khi bạn bấm Kết thúc ngày, để tính km giữa các điểm check-in. Chọn Luôn luôn để hành trình không bị đứt khi tắt màn hình.",
          "locationAlwaysPermission": "SeedGW ghi vị trí trong giờ làm việc để tính km giữa các điểm check-in.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#005b36",
          "defaultChannel": "mac-dinh"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "777ad09e-0669-4b2d-a77d-b97ef8cea83a"
      }
    },
    "owner": "vinaseed",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/777ad09e-0669-4b2d-a77d-b97ef8cea83a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
